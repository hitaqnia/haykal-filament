{
    "name": "hitaqnia/haykal-filament",
    "description": "Haykal Filament foundation: BasePanel, BaseResource, base pages, translatable tabs, base theme, Mapbox components, curated plugin set.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.5",
        "hitaqnia/haykal-core": "^3.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "lara-zeus/spatie-translatable": "^2.0",
        "tonegabes/filament-phosphor-icons": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "HiTaqnia\\Haykal\\Filament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HiTaqnia\\Haykal\\Filament\\HaykalFilamentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
